{
  "expo": {
    "name": "Framely",
    "slug": "framely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metafusion.framely",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Framely needs access to your photos so you can crop and edit them.",
        "NSPhotoLibraryAddUsageDescription": "Framely saves your cropped photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.metafusion.framely",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Framely needs access to your photos so you can crop and edit them.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Framely needs access to your photos so you can crop and edit them.",
          "savePhotosPermission": "Framely saves your cropped photos to your library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0E0E12",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d7bf2b53-998e-4eaa-b2ca-9349f2abae34"
      }
    }
  }
}
